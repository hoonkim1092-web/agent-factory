
# --- 🔐 보안 파일 (절대 올리지 마세요) ---
.env
.env.local
**/.env
secrets.json
api_key.txt

# --- 🐍 파이썬 찌꺼기 파일 ---
__pycache__/
*.pyc
.venv/
venv/
env/

# --- OS/editor local files ---
.DS_Store
**/.DS_Store

# --- Claude Code machine-local settings (each PC maintains its own) ---
# Template: .claude/settings.local.template.json
.claude/settings.local.json

# --- 🏭 에이전트 결과물 (선택 사항) ---
# 만약 생성된 에이전트 파일들을 깃에 올리기 싫다면 아래 주석을 푸세요
# agents/

# --- 📦 PyInstaller 빌드 산출물 (GitHub Release로 별도 배포) ---
# 2026-04-14 정책 변경: dist/af-{version}.zip이 ~91MB로 GitHub
# 단일 파일 100MB 한계에 근접 + git-lfs 미구성 환경에서 push 실패 발생.
# CLAUDE.md "LFS로 커밋" 규칙 폐기 → 빌드 zip은 git에서 제외하고
# `gh release create af-fsa_v{version} dist/af-{version}.zip` 으로 배포.
dist/
build/

# --- 🐍 setuptools editable install metadata (regenerated by `pip install -e .`) ---
*.egg-info/

# --- 🚀 af-fsa publish staging (temporary, regenerated per release) ---
.tmp_af_fsa_publish/

# --- 🔧 Auxiliary launcher build output ---
.a/

# --- Design Review Queue (local, auto-generated) ---
.af_review_queue/

# --- Nightly pipeline runtime state (per-workspace, auto-regenerated) ---
# .af/state_snapshot.json, .af/watchdog_state.json, .af/budget_state.json,
# .af/watchdog_lineage_counters.json, .af/lineage_ledger.json (FSA loop history),
# .af/nightly_summary.md, .af/alert.flag, .af/nightly.lock, .af/ise_ledger_*.json
.af/

# --- Warning registry — workspace 운영 데이터 (record SoT + cache, 미동기화) ---
/runtime/warnings/*
!/runtime/warnings/.gitkeep
!/runtime/warnings/_index.json

# --- Agent Factory local runtime state (per-machine, auto-regenerated) ---
# Contains CLI session state, Codex/Gemini/Claude runtime caches, auth seeds,
# sandbox state, sqlite state, shell guards, and absolute local paths.
**/.af_runtime/

# --- Setup Wizard local state (per-user secrets: TAVILY key, NotebookLM UUIDs) ---
.af_setup_state.json

# --- Session resume brief (auto-regenerated every turn, volatile) ---
/resume_brief.md

# --- Project memory data (synced via Supabase start_db/end_db, not git) ---
# All files under data/memory/ are auto-generated runtime data.
# Cross-PC sync is handled by project_context_sync.py → Supabase.
projects/*/data/memory/

# --- System-generated runtime logs & traces (auto-regenerated, machine-local) ---
.system_generated/logs/
.system_generated/cache/

# --- Stage 1 Self-Evolution Runtime Artifacts (auto-generated, machine-local) ---
candidates/
data/evolution/

# --- Skill Evaluation Runtime Artifacts (append-only per session, not source) ---
/skill-eval-report.json
/data/skill-usage.jsonl
skills/**/skill-eval-report.json
skills/**/skill-promotion.json

# --- Runtime/Test Artifacts ---
/runs/
projects/*/runs/
projects/*/dashboard.json
projects/*/skill-lock.yaml
projects/gemini_e2e/
projects/*/resume_brief.md
projects/gemini_live_edit_fix/
test_output/
dynamic_log.txt
project_board_state.json
pytest_out*.txt
tests/_tmp_probe/
tests/_tmp/
tmp*/
.tmp_validation*/
.tmp_af_fsa
.tmp_review_importer/
.tmp_review_sync/
.tmp_smoke_projects/

# --- 🎯 Developer Context Rules (DO NOT DEPLOY) ---
.gemini_dev_rules.md

# --- Dogfood interview artifact (auto-generated per run, not source) ---
planning/interview_brief.json

# --- Claude Code runtime artifacts (created by claude_cli AI executor in worktrees) ---
syncCompyne/
