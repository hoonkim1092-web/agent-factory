{
  "_comment": [
    "settings.local.json is machine-local and gitignored.",
    "Copy this file to settings.local.json — no OS-specific changes needed.",
    "hooks use 'python scripts/run.py' to avoid shell-path ambiguity on Windows."
  ],
  "permissions": {
    "allow": [
      "Bash(git *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(echo *)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py post_edit_code_review",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py post_edit_design_review",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python scripts/run.py post_agent_record",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
