{
  "_comment": [
    "settings.local.json is machine-local and gitignored.",
    "Copy this file to settings.local.json and expand permissions only for commands you explicitly trust.",
    "Shared project defaults intentionally avoid auto-allowing destructive Git, arbitrary shell/Python, package installs, or remote mutations.",
    "hooks use 'sh scripts/hookpy.sh' which auto-detects python3 or python."
  ],
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(echo:*)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(erase:*)",
      "Bash(Remove-Item:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --worktree:*)",
      "Bash(git restore --staged:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py check_pending_review.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py check_design_pending.py"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py post_edit_code_review",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "sh scripts/hookpy.sh scripts/run.py post_edit_design_review",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py post_agent_record",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
