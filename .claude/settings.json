{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch --show-current)",
      "Bash(codex --version)",
      "Bash(codex --help)",
      "Bash(command -v codex)",
      "Bash(where codex:*)",
      "Bash(python --version)",
      "Bash(python3 --version)",
      "Bash(bash --version)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__codex__codex"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(erase:*)",
      "Bash(Remove-Item:*)",
      "Bash(cmd /c del:*)",
      "Bash(powershell -Command Remove-Item:*)",
      "Bash(pwsh -Command Remove-Item:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --worktree:*)",
      "Bash(git restore --staged:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py check_pending_review.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py check_design_pending.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py check_model_escalation.py"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py cli_hook_bridge --provider claude --run-id claude_cli_run"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py post_edit_enqueue",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py post_edit_design_review",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/run.py post_agent_record",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
