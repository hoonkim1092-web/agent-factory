  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 -m py_compile \"$fp\" 2>&1 || echo \"[af-hook] syntax error in $fp\" ;; esac",
            "timeout": 10,
            "statusMessage": "Python syntax check..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 scripts/hook_runner.py code_review_updater --context \"edit: $fp\" ;; esac",
            "timeout": 120,
            "statusMessage": "Code review update..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 scripts/hook_runner.py blueprint_updater --context \"edit: $fp\" ;; esac",
            "timeout": 120,
            "statusMessage": "Blueprint update..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; python3 scripts/hook_runner.py design_review_trigger \"$fp\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Design review check..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 scripts/hook_runner.py enqueue_agent_review \"$fp\" 2>/dev/null ;; esac",
            "timeout": 3,
            "statusMessage": "Enqueue agent review..."
          },
          {
            "type": "command",
            "command": "for f in .af_review_queue/notifications/*.txt; do [ -f \"$f\" ] && cat \"$f\" && rm -f \"$f\"; done 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "name": "agent_factory_claude_sessionstart",
            "command": "python3 /Users/hoon/workTree/agent-factory/scripts/hook_runner.py cli_hook_bridge --provider claude --workspace /Users/hoon/workTree/agent-factory --run-id claude_cli_run --repo-root /Users/hoon/workTree/agent-factory"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
