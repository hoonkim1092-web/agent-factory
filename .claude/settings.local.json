{
  "permissions": {
    "allow": [
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(python -c:*)",
      "Bash(git:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(cd:*)",
      "Bash(wc:*)",
      "Bash(xargs:*)",
      "Bash(echo:*)",
      "Bash(timeout:*)",
      "Bash(sed:*)",
      "Bash(for:*)",
      "Bash(while:*)",
      "Bash(pip:*)",
      "Bash(pip3 install:*)",
      "Bash(npm:*)",
      "Bash(af:*)",
      "Bash(cp:*)",
      "Bash(which:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:aisparkup.com)",
      "WebFetch(domain:bkamp.ai)",
      "Bash(mkdir -p /tmp/af_deploy_smoke)",
      "Read(//tmp/**)",
      "Bash(ps -p 15655 -o pid,stat,etime,rss,command)",
      "Bash(ps -p 15655 -o pid,stat,etime,rss)",
      "Bash(.venv/bin/python -c \"import notebooklm_tools; print\\('OK', notebooklm_tools.__file__, notebooklm_tools.__version__ if hasattr\\(notebooklm_tools, '__version__'\\) else 'no version'\\)\")",
      "Bash(.venv/bin/pip show:*)",
      "Bash(.venv/bin/pip install:*)",
      "Bash(.venv/bin/python -c ':*)",
      "Bash(.venv/bin/nlm --help)",
      "Bash(.venv/bin/nlm auth:*)",
      "Bash(.venv/bin/nlm login:*)",
      "Bash(.venv/bin/nlm notebook:*)",
      "Bash(.venv/bin/python:*)",
      "Bash(awk '{print $1}')",
      "Bash(awk '{print $NF}')",
      "Bash(awk '{print $2}')",
      "Bash(codex --version)",
      "Bash(codex --help)",
      "Bash(codex exec:*)",
      "Bash(codex review:*)",
      "Bash(codex mcp-server:*)",
      "Bash(bash -n /Users/hoon/workTree/agent-factory/install-af.sh)",
      "Bash(/usr/bin/env python3:*)",
      "Bash(bash -n install-af.sh)",
      "Bash(unset VIRTUAL_ENV)",
      "Bash(/usr/local/Cellar/python@3.14/3.14.3_1/Frameworks/Python.framework/Versions/3.14/bin/python3.14 -c \"import sys, yaml; print\\('ok', yaml.__version__, sys.prefix\\)\")",
      "Bash(rm:*)",
      "Bash(rmdir:*)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(del:*)",
      "Bash(erase:*)",
      "Bash(Remove-Item:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --worktree:*)",
      "Bash(git restore --staged:*)",
      "Bash(cmd /c del:*)",
      "Bash(powershell -Command Remove-Item:*)",
      "Bash(pwsh -Command Remove-Item:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 -m py_compile \"$fp\" 2>&1 || echo \"[af-hook] syntax error in $fp\" ;; esac",
            "timeout": 10,
            "statusMessage": "Python syntax check..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 scripts/hook_runner.py code_review_updater --context \"edit: $fp\" 2>/dev/null ;; esac",
            "timeout": 30,
            "statusMessage": "Code review update..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 scripts/hook_runner.py blueprint_updater --context \"edit: $fp\" 2>/dev/null ;; esac",
            "timeout": 30,
            "statusMessage": "Blueprint update..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; python3 scripts/hook_runner.py design_review_trigger \"$fp\" 2>/dev/null || true",
            "timeout": 5,
            "statusMessage": "Design review check..."
          },
          {
            "type": "command",
            "command": "fp=$TOOL_INPUT_file_path; case \"$fp\" in *.py) python3 scripts/hook_runner.py enqueue_agent_review \"$fp\" 2>/dev/null ;; esac",
            "timeout": 3,
            "statusMessage": "Enqueue agent review..."
          },
          {
            "type": "command",
            "command": "for f in .af_review_queue/notifications/*.txt; do [ -f \"$f\" ] && cat \"$f\" && rm -f \"$f\"; done 2>/dev/null || true",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py cli_hook_bridge --provider claude --workspace \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" --run-id claude_cli_run --repo-root \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py cli_hook_bridge --provider claude --workspace \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" --run-id claude_cli_run --repo-root \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py check_pending_review 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py cli_hook_bridge --provider claude --workspace \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" --run-id claude_cli_run --repo-root \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py cli_hook_bridge --provider claude --workspace \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" --run-id claude_cli_run --repo-root \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 scripts/hook_runner.py cli_hook_bridge --provider claude --workspace \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\" --run-id claude_cli_run --repo-root \"$(git rev-parse --show-toplevel 2>/dev/null || pwd)\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
