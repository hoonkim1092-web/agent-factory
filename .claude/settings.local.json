{
  "permissions": {
    "allow": [
      "Bash(git checkout *)",
      "Bash(git rm *)",
      "Bash(git stash *)",
      "Bash(git clean *)",
      "Bash(git reset *)",
      "Bash(./start_db agent-factory *)",
      "Bash(codex --version)",
      "Bash(cat)",
      "Read(//tmp/**)",
      "Bash(git mv *)",
      "Bash(git add *)",
      "Bash(git commit -m ' *)",
      "Bash(git push *)",
      "Bash(python -m pytest --version)",
      "Bash(python -m pytest tests/ -q --tb=no -p no:cacheprovider --timeout=30)",
      "Bash(echo \"EXIT=$?\")",
      "Bash(python -m pytest tests/ --timeout=30)",
      "Bash(python -m pytest tests/ -q --tb=no -p no:cacheprovider)",
      "Bash(python *)",
      "Bash(where codex *)",
      "Bash(command -v codex)",
      "Bash(git commit *)",
      "Bash(python3 -m pytest tests/ --ignore=tests/_tmp --ignore=tests/test_integration --ignore=tests/test_cli_providers.py -q --tb=line)",
      "Bash(python3 -m pytest tests/test_plan_verifier.py tests/test_fsa_loop.py -v --tb=short)",
      "Bash(python3 *)",
      "Bash(git pull *)",
      "Bash(wait)",
      "Bash(git -C /Users/hoon/workTree/agent-factory log --oneline --follow core/control/maintenance_pipeline.py)",
      "Bash(git -C /Users/hoon/workTree/agent-factory show HEAD~1:core/control/maintenance_pipeline.py)",
      "Bash(git -C /Users/hoon/workTree/agent-factory diff HEAD~1 -- core/control/maintenance_pipeline.py)",
      "Bash(git -C /Users/hoon/workTree/agent-factory diff HEAD~1 -- core/pdca_commands.py)",
      "Bash(git -C /Users/hoon/workTree/agent-factory diff HEAD~1 --name-only)",
      "Bash(grep \"\\\\.py$\")",
      "Bash(supabase --version)",
      "Bash(echo \"exit=$?\")",
      "Bash(git merge *)"
    ],
    "deny": [
      "Bash(rm:*)",
      "Bash(del:*)",
      "Bash(erase:*)",
      "Bash(Remove-Item:*)",
      "Bash(cmd /c del:*)",
      "Bash(powershell -Command Remove-Item:*)",
      "Bash(pwsh -Command Remove-Item:*)",
      "Bash(git clean:*)",
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git restore --worktree:*)",
      "Bash(git restore --staged:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py cli_hook_bridge --provider claude --workspace $PWD --run-id claude_cli_run --repo-root $PWD"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py cli_hook_bridge --provider claude --workspace $PWD --run-id claude_cli_run --repo-root $PWD"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py cli_hook_bridge --provider claude --workspace $PWD --run-id claude_cli_run --repo-root $PWD"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py cli_hook_bridge --provider claude --workspace $PWD --run-id claude_cli_run --repo-root $PWD"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py cli_hook_bridge --provider claude --workspace $PWD --run-id claude_cli_run --repo-root $PWD"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py post_edit_code_review",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./scripts/hook_runner.py post_edit_design_review",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
