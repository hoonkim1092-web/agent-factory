#!/bin/sh
# pre-commit hook: review-gate first, then generated docs sync.
#
# Intended pipeline:
#   1. Implementation is staged.
#   2. Review agents / test runner have already passed.
#   3. review-gate verifies that state.
#   4. Blueprint/code-review docs are refreshed for the final commit.
#   5. Commit proceeds.

BLUEPRINT="Master_Blueprint.md"
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
VENV_PYTHON="${REPO_ROOT}/.venv/bin/python3"
# Normalize staged text files per .gitattributes (CRLF guard — Windows open("w") writes CRLF).
git diff --cached --name-only --diff-filter=ACMR | xargs -r git add --renormalize -- 2>/dev/null || true
STAGED=$(git diff --cached --name-only)

if [ -x "$VENV_PYTHON" ]; then
    HOOK_PY="$VENV_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
    HOOK_PY="python3"
else
    HOOK_PY="python"
fi

CODE_CHANGED=$(echo "$STAGED" | grep -E "^(core/|model_utils\.py|run_factory_cli\.py|version\.py|af\.spec|install-af\.ps1)" | head -1)

# Block machine-local files before any generated-doc side effects.
if git diff --cached --diff-filter=ACMRT --name-only | grep -q "^\.claude/settings\.local\.json$"; then
    echo ""
    echo "❌ [pre-commit] .claude/settings.local.json is machine-local."
    echo "   Unstage it with: git restore --staged .claude/settings.local.json"
    echo ""
    exit 1
fi

# Review gate must pass before Blueprint/code-review updater changes anything.
if [ "${AF_SKIP_REVIEW_GATE:-0}" != "1" ]; then
    # Provider-neutral fallback: Claude hooks enqueue files at edit time, but
    # Codex, IDEs, shells, or other providers may reach git commit without
    # PostToolUse hooks. Enqueue staged review targets here before checking.
    "$HOOK_PY" "${REPO_ROOT}/scripts/enqueue_staged_review.py" --workspace "${REPO_ROOT}" >/dev/null 2>&1 || true
    "$HOOK_PY" "${REPO_ROOT}/scripts/review_gate.py" --check
    GATE_EXIT=$?
    if [ $GATE_EXIT -ne 0 ]; then
        echo ""
        echo "⛔ [pre-commit] review-gate is not complete."
        echo "   Run af-critic → af-cross-review → af-test-runner, fix findings, then retry."
        echo "   Bypass: AF_SKIP_REVIEW_GATE=1 git commit ..."
        echo ""
        exit 1
    fi

    # Design-review surface: block commits of staged design docs whose latest
    # automated review verdict is BLOCK. The watcher writes verdicts to
    # docs/reviews/ but nothing reads them — this git-native, provider-neutral
    # check restores that surface (see d1022ecd: a BLOCK was committed unseen).
    # Reached on doc-only commits too: review_gate.py --check exits 0 when no
    # .py files are staged, so flow falls through to here.
    "$HOOK_PY" "${REPO_ROOT}/scripts/check_staged_design_review.py" --workspace "${REPO_ROOT}"
    DESIGN_EXIT=$?
    if [ $DESIGN_EXIT -ne 0 ]; then
        exit 1
    fi
fi

# Generated docs belong after review-gate PASS, as final commit preparation.
if [ -n "$CODE_CHANGED" ]; then
    "$HOOK_PY" "${REPO_ROOT}/scripts/blueprint_updater.py" --no-llm 2>/dev/null || true
    if git diff --name-only 2>/dev/null | grep -q "^${BLUEPRINT}$"; then
        git add "${BLUEPRINT}" 2>/dev/null || true
    fi

    "$HOOK_PY" "${REPO_ROOT}/scripts/code_review_updater.py" --no-llm 2>/dev/null || true
    if git diff --name-only 2>/dev/null | grep -q "^docs/code_review/code-review\.md$"; then
        git add "docs/code_review/code-review.md" 2>/dev/null || true
    fi

    STAGED=$(git diff --cached --name-only)
fi

# LLM Wiki: regenerate when any wiki source doc or Python symbol source is staged.
# This keeps Obsidian current for both document mirrors and symbols.md.
WIKI_TRIGGER=$(echo "$STAGED" | grep -E "^(Master_Blueprint\.md|docs/code_review/code-review\.md|NEXT_STEPS\.md)$|\.py$" | head -1)
if [ -n "$WIKI_TRIGGER" ]; then
    "$HOOK_PY" "${REPO_ROOT}/scripts/build_llm_wiki.py" --workspace "${REPO_ROOT}" >/dev/null 2>&1 || true
    git add docs/wiki/code/ 2>/dev/null || true
    "$HOOK_PY" "${REPO_ROOT}/scripts/build_knowledge_wiki.py" --workspace "${REPO_ROOT}" >/dev/null 2>&1 || true
    git add docs/wiki/ 2>/dev/null || true
fi

# Provider instructions: regenerate when SSOT or agent YAMLs are staged.
# Sync failure MUST block commit (drift prevention) — no || true.
INSTR_TRIGGER=$(echo "$STAGED" | grep -E "^(INSTRUCTIONS\.md|agents/.*\.(yaml|yml))$" | head -1)
if [ -n "$INSTR_TRIGGER" ]; then
    "$HOOK_PY" "${REPO_ROOT}/scripts/sync_provider_instructions.py" --workspace "${REPO_ROOT}"
    SYNC_EXIT=$?
    if [ $SYNC_EXIT -ne 0 ]; then
        echo ""
        echo "⛔ [pre-commit] provider instruction sync failed (exit $SYNC_EXIT)."
        echo "   Fix INSTRUCTIONS.md markers / agents YAML, then retry."
        echo "   Note: AF_SKIP_REVIEW_GATE bypass does NOT apply to SSOT sync."
        echo ""
        exit 1
    fi
    for f in CLAUDE.md AGENTS.md GEMINI.md; do
        if git diff --name-only 2>/dev/null | grep -q "^${f}$"; then
            git add "$f" 2>/dev/null || true
        fi
    done
fi

# Code commits must include Blueprint after the post-gate updater step.
if [ -n "$CODE_CHANGED" ]; then
    BLUEPRINT_STAGED=$(echo "$STAGED" | grep "^$BLUEPRINT$")
    if [ -z "$BLUEPRINT_STAGED" ]; then
        echo ""
        echo "⚠️  [pre-commit] code changed: $CODE_CHANGED"
        echo "   Master_Blueprint.md is not staged."
        echo ""
        echo "   Retry after staging Blueprint:"
        echo "     git add Master_Blueprint.md && git commit"
        echo ""
        echo "   Force without Blueprint:"
        echo "     git commit --no-verify"
        echo ""
        exit 1
    fi
fi

# verify-handoff check for staged verification reports.
if [ "${AF_PRE_COMMIT_VERIFY:-1}" != "0" ]; then
    HAS_VERIFY=$(echo "$STAGED" | grep -c "verification-report\.md$" || true)
    if [ "$HAS_VERIFY" -gt 0 ]; then
        "$HOOK_PY" "${REPO_ROOT}/scripts/verify_handoff_checker.py" 2>&1
        VERIFY_EXIT=$?
        if [ $VERIFY_EXIT -ne 0 ]; then
            echo ""
            echo "   Bypass: AF_PRE_COMMIT_VERIFY=0 git commit"
            echo ""
            exit 1
        fi
    fi
fi

exit 0
