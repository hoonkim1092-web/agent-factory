#!/bin/sh
# pre-commit hook: review-gate first, then generated docs sync.
#
# Intended pipeline:
#   1. Implementation is staged.
#   2. Review agents / test runner have already passed.
#   3. review-gate verifies that state.
#   4. Blueprint/code-review docs are refreshed for the final commit.
#   5. Commit proceeds.

BLUEPRINT="Master_Blueprint.md"
STAGED=$(git diff --cached --name-only)
REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
VENV_PYTHON="${REPO_ROOT}/.venv/bin/python3"

if [ -x "$VENV_PYTHON" ]; then
    HOOK_PY="$VENV_PYTHON"
elif command -v python3 >/dev/null 2>&1; then
    HOOK_PY="python3"
else
    HOOK_PY="python"
fi

CODE_CHANGED=$(echo "$STAGED" | grep -E "^(core/|model_utils\.py|run_factory_cli\.py|version\.py|af\.spec|install-af\.ps1)" | head -1)

# Block machine-local files before any generated-doc side effects.
if git diff --cached --diff-filter=ACMRT --name-only | grep -q "^\.claude/settings\.local\.json$"; then
    echo ""
    echo "❌ [pre-commit] .claude/settings.local.json is machine-local."
    echo "   Unstage it with: git restore --staged .claude/settings.local.json"
    echo ""
    exit 1
fi

# Review gate must pass before Blueprint/code-review updater changes anything.
if [ "${AF_SKIP_REVIEW_GATE:-0}" != "1" ]; then
    "$HOOK_PY" "${REPO_ROOT}/scripts/review_gate.py" --check
    GATE_EXIT=$?
    if [ $GATE_EXIT -ne 0 ]; then
        echo ""
        echo "⛔ [pre-commit] review-gate is not complete."
        echo "   Run af-critic → af-cross-review → af-test-runner, fix findings, then retry."
        echo "   Bypass: AF_SKIP_REVIEW_GATE=1 git commit ..."
        echo ""
        exit 1
    fi
fi

# Generated docs belong after review-gate PASS, as final commit preparation.
if [ -n "$CODE_CHANGED" ]; then
    "$HOOK_PY" "${REPO_ROOT}/scripts/blueprint_updater.py" --no-llm 2>/dev/null || true
    if git diff --name-only 2>/dev/null | grep -q "^${BLUEPRINT}$"; then
        git add "${BLUEPRINT}" 2>/dev/null || true
    fi

    "$HOOK_PY" "${REPO_ROOT}/scripts/code_review_updater.py" --no-llm 2>/dev/null || true
    if git diff --name-only 2>/dev/null | grep -q "^docs/code_review/code-review\.md$"; then
        git add "docs/code_review/code-review.md" 2>/dev/null || true
    fi

    STAGED=$(git diff --cached --name-only)
fi

# Code commits must include Blueprint after the post-gate updater step.
if [ -n "$CODE_CHANGED" ]; then
    BLUEPRINT_STAGED=$(echo "$STAGED" | grep "^$BLUEPRINT$")
    if [ -z "$BLUEPRINT_STAGED" ]; then
        echo ""
        echo "⚠️  [pre-commit] code changed: $CODE_CHANGED"
        echo "   Master_Blueprint.md is not staged."
        echo ""
        echo "   Retry after staging Blueprint:"
        echo "     git add Master_Blueprint.md && git commit"
        echo ""
        echo "   Force without Blueprint:"
        echo "     git commit --no-verify"
        echo ""
        exit 1
    fi
fi

# verify-handoff check for staged verification reports.
if [ "${AF_PRE_COMMIT_VERIFY:-1}" != "0" ]; then
    HAS_VERIFY=$(echo "$STAGED" | grep -c "verification-report\.md$" || true)
    if [ "$HAS_VERIFY" -gt 0 ]; then
        "$HOOK_PY" "${REPO_ROOT}/scripts/verify_handoff_checker.py" 2>&1
        VERIFY_EXIT=$?
        if [ $VERIFY_EXIT -ne 0 ]; then
            echo ""
            echo "   Bypass: AF_PRE_COMMIT_VERIFY=0 git commit"
            echo ""
            exit 1
        fi
    fi
fi

exit 0
