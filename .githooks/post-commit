#!/bin/sh
# git-lfs (optional — Blueprint 업데이트는 git-lfs 없어도 계속 실행)
if command -v git-lfs >/dev/null 2>&1; then
    git lfs post-commit "$@"
fi

# ── 문서 자동 업데이트 (Blueprint + code-review) ──
# 코드 파일 변경이 있을 때만 실행, 항상 exit 0
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)
CODE_CHANGED=$(echo "$CHANGED" | grep -E "^(core/|scripts/|skills/|run_factory_cli\.py|model_utils\.py|version\.py|af\.spec)" | head -1)

if [ -n "$CODE_CHANGED" ]; then
    # rebase/merge/cherry-pick 중이면 문서 업데이트 스킵 (amend 위험 방지)
    GIT_DIR=$(git rev-parse --git-dir 2>/dev/null)
    if [ -d "$GIT_DIR/rebase-merge" ] || \
       [ -d "$GIT_DIR/rebase-apply" ] || \
       [ -f "$GIT_DIR/MERGE_HEAD" ] || \
       [ -f "$GIT_DIR/CHERRY_PICK_HEAD" ]; then
        exit 0
    fi

    COMMIT_MSG=$(git log -1 --format=%s 2>/dev/null)

    # Blueprint §12 자동 업데이트
    python scripts/blueprint_updater.py --context "$COMMIT_MSG" 2>/dev/null &

    # Code review 자동 업데이트
    python scripts/code_review_updater.py --context "$COMMIT_MSG" 2>/dev/null &

    wait

    # Blueprint / code-review.md 변경 시 자동 amend
    AMENDED=0
    if git diff --name-only 2>/dev/null | grep -q "Master_Blueprint.md"; then
        git add Master_Blueprint.md 2>/dev/null
        AMENDED=1
    fi
    if git diff --name-only 2>/dev/null | grep -q "docs/code_review/code-review.md"; then
        git add docs/code_review/code-review.md 2>/dev/null
        AMENDED=1
    fi
    if [ "$AMENDED" = "1" ]; then
        git commit --amend --no-edit 2>/dev/null
    fi
fi
