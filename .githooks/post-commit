#!/bin/sh
# git-lfs (optional)
if command -v git-lfs >/dev/null 2>&1; then
    git lfs post-commit "$@"
fi

# ── review-gate 큐 클리어 (commit 성공 후) ──
# Round 1 dogfooding fix: PostToolUse Bash hook 미등록으로 큐가 stale 누적되던 버그 해소.
# .py 0건 커밋도 호출하지만 clear_committed_files가 committed_set로 필터링하므로 무해.
CHANGED=$(git diff-tree --no-commit-id --name-only -r HEAD 2>/dev/null)
if [ -n "$CHANGED" ]; then
    REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    VENV_PYTHON="${REPO_ROOT}/.venv/bin/python3"
    if [ -x "$VENV_PYTHON" ]; then CLEAR_PY="$VENV_PYTHON"
    elif command -v python3 >/dev/null 2>&1; then CLEAR_PY="python3"
    else CLEAR_PY="python"; fi
    COMMITTED=$(echo "$CHANGED" | tr '\n' ',' | sed 's/,$//')
    "$CLEAR_PY" "${REPO_ROOT}/scripts/review_gate.py" --clear --files "$COMMITTED" >/dev/null 2>&1 || true
fi

# §3 manual fallback reminder. pre-commit runs blueprint_updater.py and stages
# Master_Blueprint.md for normal code commits, so only warn when a core change
# landed without Blueprint in the same commit (for example --no-verify).
CORE_CHANGED=$(echo "$CHANGED" | grep "^core/.*\.py$" | head -1)
BLUEPRINT_CHANGED=$(echo "$CHANGED" | grep "^Master_Blueprint\.md$" | head -1)
if [ -n "$CORE_CHANGED" ] && [ -z "$BLUEPRINT_CHANGED" ]; then
    echo ""
    echo "  [blueprint] core change committed without Master_Blueprint.md: $CORE_CHANGED"
    echo "     Run scripts/blueprint_updater.py or commit the generated Blueprint sync."
    echo ""
fi
